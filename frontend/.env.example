# ASCOS frontend configuration.
# Copy to .env.local (gitignored) and fill in from the Terraform outputs:
#   terraform output -raw api_endpoint            -> VITE_API_BASE_URL
#   terraform output -raw cognito_user_pool_id    -> VITE_COGNITO_USER_POOL_ID
#   terraform output -raw cognito_app_client_id   -> VITE_COGNITO_CLIENT_ID
#   terraform output -raw aws_region              -> VITE_AWS_REGION
#
# All four are REQUIRED. The app refuses to start (and `npm run build` fails)
# if any is missing. There is no mock/demo mode in this build.

# API Gateway HTTP API base URL: no trailing slash, no stage path
# (the deployed API uses the $default stage).
VITE_API_BASE_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_AWS_REGION=

# OPTIONAL - only set if the AWS Budgets configuration is exposed from a real
# source (e.g. Terraform outputs). If either is unset the Budget page shows no
# amounts. These describe a monitoring alert threshold, NOT a spending cap.
# VITE_BUDGET_MONTHLY_USD=
# VITE_BUDGET_ALERT_PERCENT=

# OPTIONAL - monthly storage rates in USD per GB. The Cost & Budget page shows
# tier costs only when all three rates are supplied. Set these from your actual
# AWS pricing/contract for the deployment; no rates are assumed by the app.
# VITE_RATE_HOT_PER_GB_MONTH=
# VITE_RATE_WARM_PER_GB_MONTH=
# VITE_RATE_COLD_PER_GB_MONTH=

# OPTIONAL - enable ML predictions feature. Set to "true" to enable the Predictions page.
# If unset or "false", the predictions capability is disabled.
VITE_PREDICTIONS_ENABLED=false

# OPTIONAL - local Ollama assistant mode. Disabled by default. The Vite dev
# server proxies /ollama to this URL to avoid browser CORS restrictions.
# Example: run Ollama at http://localhost:11434 and pull the selected model.
VITE_OLLAMA_ENABLED=false
VITE_OLLAMA_URL=
# VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=
# VITE_OLLAMA_MODEL=llama3.2:3b
# If you prefer to call Ollama directly instead of using the Vite proxy, configure
# Ollama's OLLAMA_ORIGINS to allow the frontend origin (for example,
# OLLAMA_ORIGINS=http://localhost:3000).

# OPTIONAL - model note displayed in footer of Predictions page. If unset or empty,
# no footer is shown. Example value:
# VITE_MODEL_NOTE="Model: LightGBM · bootstrap-trained on synthetic data · predictions refreshed by batch job"
# VITE_MODEL_NOTE=
